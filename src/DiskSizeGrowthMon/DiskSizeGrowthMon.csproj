<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DiskSizeGrowthMon</AssemblyName>
    <RootNamespace>DiskSizeGrowthMon</RootNamespace>
    <Product>Disk Size Growth Monitor</Product>
    <Company>disk-size-growth-mon</Company>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>

    <!-- Requires elevation (see app.manifest) so system folders can be enumerated. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Must stay false: in globalization-invariant mode WinForms throws a
         CultureNotFoundException while handling WM_INPUTLANGCHANGE (the message Windows
         posts when the app gains/loses focus with a keyboard layout switch), because
         InputLanguage.LanguageTag resolves the layout's LCID via CultureInfo.GetCultureInfo(int).
         On Windows the ICU data comes from the OS (icu.dll), so this costs no extra size. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Publish-time only; harmless for plain `dotnet build`. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The cleanup scripts ship as loose files in dist\cleanup\, not embedded: the whole point is
       that you can read them before running them, and edit or add your own afterwards. -->
  <ItemGroup>
    <None Include="..\..\cleanup\**\*" LinkBase="cleanup" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
